{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
  ],
  enabledManagers: [
    "cargo",
    "github-actions",
    "mise",
    "npm",
  ],
  // `build(deps):`, which is the type the workspace already uses for dependency commits.
  semanticCommitType: "build",
  // pnpm refuses to install a release under a day old, so anything younger than that produces a
  // lockfile its own `--frozen-lockfile` check then rejects. Two days of margin over that.
  minimumReleaseAge: "3 days",
  // Both lockfiles are committed, and CI reads them with `--locked` and `--frozen-lockfile`.
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      description: "One PR per ecosystem rather than one per crate",
      matchManagers: ["cargo"],
      groupName: "cargo",
    },
    {
      description: "The desktop front end, lockfile included",
      matchManagers: ["npm"],
      groupName: "npm",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      description: "The toolchains in mise.toml, which CI installs from",
      matchManagers: ["mise"],
      groupName: "toolchains",
    },
  ],
}
